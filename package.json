{
  "name": "lucasapp-cli",
  "version": "0.8.0",
  "description": "LucasApp CLI - Financial data management for AI agents",
  "author": "StevenACZ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StevenACZ/lucas-cli.git"
  },
  "homepage": "https://github.com/StevenACZ/lucas-cli",
  "type": "module",
  "packageManager": "bun@1.3.12",
  "bin": {
    "lucas": "dist/index.js"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "prepack": "bun run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "bunx typescript@7.0.2 --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "lucasapp",
    "finance",
    "cli",
    "ai-agents"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
